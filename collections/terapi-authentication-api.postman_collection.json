          "name": "Get Authentication Token",
          "request": {
            "name": "Get Authentication Token",
            "description": {
              "content": "Returns the current authentication token for a connection. Terapi automatically refreshes OAuth tokens as needed before returning.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "auth",
                "token",
                ":provider_config_key",
                ":connection_id"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "force_refresh",
                  "value": "false",
                  "description": "Force a token refresh even if the current token is still valid"
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "provider_config_key",
                  "description": "(Required) The provider config key"
                },
                {
                  "disabled": false,
